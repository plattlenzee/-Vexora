<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Vexora — AI Game Builder</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #07070a;
      color: white;
      min-height: 100vh;
    }

    header {
      height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 7%;
      border-bottom: 1px solid #1b1b22;
    }

    .logo {
      font-size: 25px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .logo span {
      color: #8b5cf6;
    }

    .credits {
      background: #15151c;
      border: 1px solid #282832;
      padding: 10px 15px;
      border-radius: 12px;
      font-size: 14px;
    }

    main {
      max-width: 900px;
      margin: auto;
      padding: 90px 20px;
      text-align: center;
    }

    .badge {
      display: inline-block;
      background: #12101b;
      border: 1px solid #29223d;
      color: #a78bfa;
      padding: 8px 14px;
      border-radius: 50px;
      font-size: 13px;
      margin-bottom: 25px;
    }

    h1 {
      font-size: clamp(45px, 9vw, 80px);
      line-height: 0.95;
      letter-spacing: -4px;
      margin-bottom: 25px;
    }

    h1 span {
      background: linear-gradient(90deg, #8b5cf6, #c084fc);
      -webkit-background-clip: text;
      color: transparent;
    }

    .subtitle {
      color: #92929d;
      font-size: 18px;
      max-width: 600px;
      margin: auto;
      line-height: 1.6;
    }

    .box {
      margin: 45px auto 0;
      max-width: 700px;
      background: #101014;
      border: 1px solid #292930;
      border-radius: 20px;
      padding: 18px;
      text-align: left;
      box-shadow: 0 20px 70px rgba(0,0,0,.35);
    }

    textarea {
      width: 100%;
      height: 130px;
      resize: none;
      border: none;
      outline: none;
      background: transparent;
      color: white;
      font-size: 16px;
      font-family: inherit;
    }

    textarea::placeholder {
      color: #666671;
    }

    .bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 15px;
    }

    .hint {
      color: #666671;
      font-size: 13px;
    }

    button {
      border: none;
      background: #8b5cf6;
      color: white;
      padding: 12px 20px;
      border-radius: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover {
      background: #7c4de8;
    }

    .projects {
      margin-top: 80px;
      text-align: left;
    }

    .projects h2 {
      margin-bottom: 18px;
      font-size: 22px;
    }

    .project {
      background: #101014;
      border: 1px solid #22222a;
      padding: 20px;
      border-radius: 15px;
      color: #9999a3;
    }

    @media (max-width: 600px) {
      header {
        padding: 0 20px;
      }

      main {
        padding-top: 60px;
      }

      h1 {
        letter-spacing: -2px;
      }

      .credits {
        font-size: 12px;
      }

      .bottom {
        align-items: flex-end;
      }
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">VEX<span>ORA</span></div>
    <div class="credits">⚡ 100 crédits</div>
  </header>

  <main>

    <div class="badge">✦ AI GAME BUILDER</div>

    <h1>
      Build your game.<br>
      <span>Just imagine it.</span>
    </h1>

    <p class="subtitle">
      Décris le jeu que tu imagines et Vexora s'occupe du reste.
      Une nouvelle façon de créer des expériences Roblox.
    </p>

    <div class="box">

      <textarea
        placeholder="Décris le jeu que tu veux créer..."
      ></textarea>

      <div class="bottom">
        <div class="hint">Vexora AI · 100 crédits disponibles</div>
        <button onclick="generate()">Générer</button>
      </div>

    </div>

    <div class="projects">
      <h2>Mes projets</h2>

      <div class="project">
        Aucun projet pour le moment.
      </div>
    </div>

  </main>

  <script>
    function generate() {
      const text = document.querySelector("textarea").value;

      if (text.trim() === "") {
        alert("Décris d'abord le jeu que tu veux créer !");
        return;
      }

      alert("Vexora va bientôt commencer la génération 🚀");
    }
  </script>

</body>
</html>